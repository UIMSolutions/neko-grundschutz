{
  "xsappname": "grundschutz",
  "tenant-mode": "dedicated",
  "description": "BSI IT-Grundschutz project management",
  "scopes": [
    { "name": "$XSAPPNAME.Viewer", "description": "Read Grundschutz projects" },
    { "name": "$XSAPPNAME.Editor", "description": "Maintain target objects, requirements and risks" },
    { "name": "$XSAPPNAME.Admin", "description": "Delete projects" }
  ],
  "role-templates": [
    { "name": "Auditor", "description": "Read-only access (e.g. auditors)", "scope-references": ["$XSAPPNAME.Viewer"] },
    { "name": "SecurityOfficer", "description": "Information security officer (ISB)", "scope-references": ["$XSAPPNAME.Viewer", "$XSAPPNAME.Editor"] },
    { "name": "Administrator", "description": "Full access", "scope-references": ["$XSAPPNAME.Viewer", "$XSAPPNAME.Editor", "$XSAPPNAME.Admin"] }
  ],
  "role-collections": [
    { "name": "Grundschutz_Auditor", "role-template-references": ["$XSAPPNAME.Auditor"] },
    { "name": "Grundschutz_SecurityOfficer", "role-template-references": ["$XSAPPNAME.SecurityOfficer"] },
    { "name": "Grundschutz_Administrator", "role-template-references": ["$XSAPPNAME.Administrator"] }
  ],
  "oauth2-configuration": {
    "token-validity": 3600,
    "redirect-uris": ["https://*.hana.ondemand.com/**", "http://localhost:5000/**"]
  }
}
