<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="objectDialog" title="{i18n>createObject}" contentWidth="30rem">
    <content>
      <VBox id="objectForm" class="sapUiSmallMargin">
        <Label id="odNameL" text="{i18n>name}" labelFor="odName" required="true"/>
        <Input id="odName" value="{newObject>/name}"/>
        <Label id="odKindL" text="{i18n>kind}" labelFor="odKind"/>
        <Select id="odKind" width="100%" selectedKey="{newObject>/kind}" items="{path: 'enums>/objectKinds', templateShareable: false}">
          <core:Item key="{enums>key}" text="{path: 'enums>key', formatter: '.formatter.enumText'}"/>
        </Select>
        <Label id="odDescL" text="{i18n>description}" labelFor="odDesc"/>
        <TextArea id="odDesc" width="100%" value="{newObject>/description}"/>
        <Label id="odCL" text="{i18n>confidentiality}" labelFor="odC"/>
        <SegmentedButton id="odC" selectedKey="{newObject>/confidentiality}" items="{path: 'enums>/protectionLevels', templateShareable: false}">
          <items><SegmentedButtonItem key="{enums>key}" text="{path: 'enums>key', formatter: '.formatter.enumText'}"/></items>
        </SegmentedButton>
        <Label id="odIL" text="{i18n>integrity}" labelFor="odI"/>
        <SegmentedButton id="odI" selectedKey="{newObject>/integrity}" items="{path: 'enums>/protectionLevels', templateShareable: false}">
          <items><SegmentedButtonItem key="{enums>key}" text="{path: 'enums>key', formatter: '.formatter.enumText'}"/></items>
        </SegmentedButton>
        <Label id="odAL" text="{i18n>availability}" labelFor="odA"/>
        <SegmentedButton id="odA" selectedKey="{newObject>/availability}" items="{path: 'enums>/protectionLevels', templateShareable: false}">
          <items><SegmentedButtonItem key="{enums>key}" text="{path: 'enums>key', formatter: '.formatter.enumText'}"/></items>
        </SegmentedButton>
        <Label id="odRatL" text="{i18n>rationale}" labelFor="odRat"/>
        <TextArea id="odRat" width="100%" value="{newObject>/protectionRationale}"/>
      </VBox>
    </content>
    <beginButton><Button id="odSave" text="{i18n>create}" type="Emphasized" press=".onCreateObject"/></beginButton>
    <endButton><Button id="odCancel" text="{i18n>cancel}" press=".onCloseDialog('objectDialog')"/></endButton>
  </Dialog>
</core:FragmentDefinition>
