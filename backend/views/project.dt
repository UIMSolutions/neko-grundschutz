extends layout

block content
  - import uim.myfiori.presentation.web.helpers;
  - import std.array : join;
  - import std.conv : to;
  - string tabClass(string t) { return t == tab ? "tab tab-active" : "tab"; }
  .text-sm.breadcrumbs
    ul
      li
        a(href="/web") Projekte
      li #{project.name}
  .flex.flex-wrap.items-center.justify-between.gap-4.mb-4
    div
      h1.text-2xl.font-bold #{project.name}
      p.text-sm.opacity-70 #{project.scope_}
    .flex.gap-2.items-center.flex-wrap
      a.btn.btn-sm.btn-outline(href="/web/projects/#{project.ID}/print", target="_blank") 🖨 Drucken
      a.btn.btn-sm.btn-outline(href="/api/projects/#{project.ID}/export") ↓ Projekt exportieren
      span(class=badge(project.status)) #{de(project.status)}
      span.badge.badge-outline #{de(project.approach)}-Absicherung

  .stats.stats-vertical.shadow.w-full.mb-6(class="md:stats-horizontal")
    .stat
      .stat-title Zielobjekte
      .stat-value #{report.targetObjectCount}
      .stat-desc #{report.objectsRequiringRiskAnalysis.length} mit Risikoanalyse-Bedarf
    .stat
      .stat-title Schutzbedarf (Max.)
      .stat-value.text-2xl #{de(report.protectionLevel)}
      .stat-desc V #{de(report.confidentiality)} · I #{de(report.integrity)} · A #{de(report.availability)}
    .stat
      .stat-title Erfüllungsgrad
      .stat-value #{percent(report.complianceDegree)}
      .stat-desc #{report.requirementsFulfilled}/#{report.requirementsTotal} erfüllt · #{report.basicRequirementsOpen} Basis offen
    .stat
      .stat-title Risiken
      .stat-value #{report.risksTotal}
      .stat-desc.text-error #{report.risksHigh + report.risksVeryHigh} hoch/sehr hoch · #{report.risksUntreated} unbehandelt

  .tabs.tabs-boxed.mb-4(role="tablist")
    a(class=tabClass("objects"), href="?tab=objects", role="tab") Zielobjekte
    a(class=tabClass("requirements"), href="?tab=requirements", role="tab") Grundschutz-Check
    a(class=tabClass("risks"), href="?tab=risks", role="tab") Risikoanalyse
    a(class=tabClass("report"), href="?tab=report", role="tab") Bericht
    a(class=tabClass("settings"), href="?tab=settings", role="tab") Einstellungen

  //- ------------------------------------------------------------ target objects
  - if (tab == "objects")
    .grid.gap-4(class="lg:grid-cols-3")
      .flex.flex-col.gap-3(class="lg:col-span-2")
        - if (objects.length == 0)
          .alert Noch keine Zielobjekte modelliert (Strukturanalyse).
        - foreach (o; objects)
          .collapse.collapse-arrow.bg-base-100.shadow
            input(type="checkbox")
            .collapse-title.flex.flex-wrap.items-center.gap-2
              span.font-semibold #{o.name}
              span.badge.badge-ghost #{de(o.kind)}
              span(class=badge(o.confidentiality)) V: #{de(o.confidentiality)}
              span(class=badge(o.integrity)) I: #{de(o.integrity)}
              span(class=badge(o.availability)) A: #{de(o.availability)}
              - if (o.requiresRiskAnalysis)
                span.badge.badge-error.badge-outline Risikoanalyse
            .collapse-content.flex.flex-col.gap-4
              p.text-sm #{o.description}
              form.grid.gap-2(method="post", action="/web/objects/#{o.ID}", class="md:grid-cols-3")
                input(type="hidden", name="csrf", value=csrf)
                input(type="hidden", name="tab", value="objects")
                - foreach (field; ["confidentiality", "integrity", "availability"])
                  label.form-control
                    span.label-text= ciaLabel(field)
                    select.select.select-bordered.select-sm(name=field)
                      - auto current = field == "confidentiality" ? o.confidentiality : field == "integrity" ? o.integrity : o.availability;
                      - foreach (l; protectionLevels)
                        option(value=l, selected=(l == current)) #{de(l)}
                label.form-control(class="md:col-span-3")
                  span.label-text Begründung der Schutzbedarfsfeststellung
                  textarea.textarea.textarea-bordered.textarea-sm(name="protectionRationale")= o.protectionRationale
                .flex.gap-2(class="md:col-span-3")
                  button.btn.btn-primary.btn-sm(type="submit") Schutzbedarf speichern
              form.flex.flex-wrap.gap-2.items-end(method="post", action="/web/objects/#{o.ID}/modules")
                input(type="hidden", name="csrf", value=csrf)
                input(type="hidden", name="tab", value="objects")
                label.form-control
                  span.label-text Baustein modellieren
                  select.select.select-bordered.select-sm(name="moduleCode")
                    - foreach (m; modules)
                      option(value=m.code) #{m.code} #{m.title}
                button.btn.btn-secondary.btn-sm(type="submit") Anwenden
              form(method="post", action="/web/objects/#{o.ID}/delete", onsubmit="return confirm('Zielobjekt inkl. Anforderungen und Risiken löschen?')")
                input(type="hidden", name="csrf", value=csrf)
                input(type="hidden", name="tab", value="objects")
                button.btn.btn-error.btn-outline.btn-xs(type="submit") Löschen
      .card.bg-base-100.shadow.h-fit
        .card-body
          h2.card-title Neues Zielobjekt
          form.flex.flex-col.gap-2(method="post", action="/web/projects/#{project.ID}/objects")
            input(type="hidden", name="csrf", value=csrf)
            input(type="hidden", name="tab", value="objects")
            input.input.input-bordered.input-sm(name="name", placeholder="Name *", required)
            select.select.select-bordered.select-sm(name="kind")
              - foreach (k; objectKinds)
                option(value=k, selected=(k == "itSystem")) #{de(k)}
            textarea.textarea.textarea-bordered.textarea-sm(name="description", placeholder="Beschreibung")
            .grid.grid-cols-3.gap-1
              - foreach (field; ["confidentiality", "integrity", "availability"])
                select.select.select-bordered.select-xs(name=field, title=field)
                  - foreach (l; protectionLevels)
                    option(value=l) #{ciaShort(field)}: #{de(l)}
            textarea.textarea.textarea-bordered.textarea-sm(name="protectionRationale", placeholder="Begründung (Pflicht bei Schutzbedarf > normal)")
            button.btn.btn-primary.btn-sm(type="submit") Anlegen

  //- ------------------------------------------------------------ requirements
  - if (tab == "requirements")
    - if (requirements.length == 0)
      .alert Noch keine Anforderungen. Wenden Sie im Reiter „Zielobjekte“ Bausteine an.
    - else
      .overflow-x-auto.bg-base-100.shadow.rounded-box
        table.table.table-sm
          thead
            tr
              th Anforderung
              th Zielobjekt
              th Art
              th Umsetzung
          tbody
            - foreach (r; requirements)
              tr
                td
                  .font-mono.text-xs #{r.code}
                  div #{r.title}
                td.whitespace-nowrap= objectNames.get(r.targetObjectId, "?")
                td
                  span(class=badge(r.level)) #{de(r.level)}
                td
                  form.flex.flex-wrap.gap-1.items-center(method="post", action="/web/requirements/#{r.ID}")
                    input(type="hidden", name="csrf", value=csrf)
                    input(type="hidden", name="tab", value="requirements")
                    select.select.select-bordered.select-xs(name="status")
                      - foreach (s; implementationStatuses)
                        option(value=s, selected=(s == r.status)) #{de(s)}
                    input.input.input-bordered.input-xs(name="responsible", value=r.responsible, placeholder="verantwortlich")
                    input.input.input-bordered.input-xs(type="date", name="dueDate", value=r.dueDate)
                    input.input.input-bordered.input-xs.w-48(name="note", value=r.note, placeholder="Begründung / Umsetzung")
                    button.btn.btn-primary.btn-xs(type="submit") ✓

  //- ------------------------------------------------------------ risks
  - if (tab == "risks")
    .grid.gap-4(class="lg:grid-cols-3")
      .overflow-x-auto.bg-base-100.shadow.rounded-box(class="lg:col-span-2")
        table.table.table-sm
          thead
            tr
              th Gefährdung
              th Zielobjekt
              th Bewertung
              th Behandlung
          tbody
            - foreach (k; risks)
              tr
                td
                  .font-mono.text-xs #{k.threatCode}
                  div #{k.title}
                  .text-xs.opacity-70 #{k.description}
                td= objectNames.get(k.targetObjectId, "?")
                td
                  span(class=badge(k.level)) #{de(k.level)}
                  .text-xs #{frequencyLabel(k.frequency)} / #{impactLabel(k.impact)}
                td
                  form.flex.flex-col.gap-1(method="post", action="/web/risks/#{k.ID}")
                    input(type="hidden", name="csrf", value=csrf)
                    input(type="hidden", name="tab", value="risks")
                    select.select.select-bordered.select-xs(name="treatment")
                      - foreach (t; treatments)
                        option(value=t, selected=(t == k.treatment)) #{de(t)}
                    input.input.input-bordered.input-xs(name="treatmentNote", value=k.treatmentNote, placeholder="Begründung / Maßnahme")
                    button.btn.btn-primary.btn-xs(type="submit") Speichern
        - if (risks.length == 0)
          p.p-4.text-sm Keine Risiken erfasst. Für Zielobjekte mit erhöhtem Schutzbedarf ist eine Risikoanalyse nach BSI 200-3 erforderlich.
      .card.bg-base-100.shadow.h-fit
        .card-body
          h2.card-title Risiko erfassen
          - if (objects.length == 0)
            p.text-sm Bitte zuerst Zielobjekte anlegen.
          - else
            form.flex.flex-col.gap-2(method="post", action="/web/projects/#{project.ID}/risks")
              input(type="hidden", name="csrf", value=csrf)
              input(type="hidden", name="tab", value="risks")
              select.select.select-bordered.select-sm(name="targetObjectId")
                - foreach (o; objects)
                  option(value=o.ID) #{o.name}
              select.select.select-bordered.select-sm(name="threatCode")
                - foreach (t; threats)
                  option(value=t.code) #{t.code} #{t.title}
              input.input.input-bordered.input-sm(name="title", placeholder="Titel *", required)
              textarea.textarea.textarea-bordered.textarea-sm(name="description", placeholder="Szenario")
              label.form-control
                span.label-text Eintrittshäufigkeit
                select.select.select-bordered.select-sm(name="frequency")
                  - foreach (v; 1 .. 5)
                    option(value=v) #{v} – #{frequencyLabel(v)}
              label.form-control
                span.label-text Schadenshöhe
                select.select.select-bordered.select-sm(name="impact")
                  - foreach (v; 1 .. 5)
                    option(value=v) #{v} – #{impactLabel(v)}
              select.select.select-bordered.select-sm(name="treatment")
                - foreach (t; treatments)
                  option(value=t) #{de(t)}
              input.input.input-bordered.input-sm(name="treatmentNote", placeholder="Begründung (Pflicht bei Akzeptanz hoher Risiken)")
              button.btn.btn-primary.btn-sm(type="submit") Erfassen

  //- ------------------------------------------------------------ report
  - if (tab == "report")
    .card.bg-base-100.shadow
      .card-body
        h2.card-title Sicherheitskonzept – Kurzbericht
        table.table
          tbody
            tr
              th Vorgehensweise
              td #{de(project.approach)}-Absicherung
            tr
              th Verantwortlich
              td #{project.owner}
            tr
              th Schutzbedarf (Maximumprinzip)
              td Vertraulichkeit #{de(report.confidentiality)}, Integrität #{de(report.integrity)}, Verfügbarkeit #{de(report.availability)}
            tr
              th Risikoanalyse erforderlich für
              td= report.objectsRequiringRiskAnalysis.length ? report.objectsRequiringRiskAnalysis.join(", ") : "–"
            tr
              th Anforderungen (relevant)
              td #{report.requirementsTotal}: #{report.requirementsFulfilled} ja · #{report.requirementsPartially} teilweise · #{report.requirementsNotFulfilled} nein · #{report.requirementsOpen} offen · #{report.requirementsDispensable} entbehrlich
            tr
              th Basis-Anforderungen
              td= report.basicProtectionAchieved ? "alle erfüllt" : report.basicRequirementsOpen.to!string ~ " noch nicht erfüllt"
            tr
              th Risiken
              td #{report.risksLow} gering · #{report.risksMedium} mittel · #{report.risksHigh} hoch · #{report.risksVeryHigh} sehr hoch (#{report.risksUntreated} unbehandelt)
        p.text-xs.opacity-60 JSON: /odata/v4/grundschutz/GetProjectReport(projectId='#{project.ID}')

  //- ------------------------------------------------------------ settings
  - if (tab == "settings")
    .card.bg-base-100.shadow.max-w-2xl
      .card-body
        form.flex.flex-col.gap-3(method="post", action="/web/projects/#{project.ID}")
          input(type="hidden", name="csrf", value=csrf)
          input(type="hidden", name="tab", value="settings")
          label.form-control
            span.label-text Name
            input.input.input-bordered(name="name", value=project.name, required)
          label.form-control
            span.label-text Informationsverbund / Geltungsbereich
            textarea.textarea.textarea-bordered(name="scope")= project.scope_
          label.form-control
            span.label-text Beschreibung
            textarea.textarea.textarea-bordered(name="description")= project.description
          label.form-control
            span.label-text Verantwortlich (ISB)
            input.input.input-bordered(name="owner", value=project.owner)
          .grid.grid-cols-2.gap-3
            label.form-control
              span.label-text Vorgehensweise
              select.select.select-bordered(name="approach")
                - foreach (a; approaches)
                  option(value=a, selected=(a == project.approach)) #{de(a)}-Absicherung
            label.form-control
              span.label-text Status
              select.select.select-bordered(name="status")
                - foreach (s; projectStatuses)
                  option(value=s, selected=(s == project.status)) #{de(s)}
          button.btn.btn-primary(type="submit") Speichern
        .divider
        form(method="post", action="/web/projects/#{project.ID}/delete", onsubmit="return confirm('Projekt mit allen Daten unwiderruflich löschen?')")
          input(type="hidden", name="csrf", value=csrf)
          input(type="hidden", name="tab", value="settings")
          button.btn.btn-error.btn-outline(type="submit") Projekt löschen
