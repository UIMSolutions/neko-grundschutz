extends layout

block content
  - import uim.myfiori.presentation.web.helpers;
  nav.bottom-margin
    h5.max.no-margin Benutzerverwaltung
    button(type="button", data-dialog="#new-user")
      i person_add
      span Neuer Benutzer
  p.small-text.muted
    | Rollen: <b>Leser</b> sehen alle Daten · <b>Bearbeiter</b> pflegen Projekte, Zielobjekte, Anforderungen und Risiken und importieren ·
    | <b>Administratoren</b> löschen Projekte, sichern / stellen wieder her und verwalten Benutzer.

  article.round.no-padding
    .table-wrap
      table.stripes
        thead
          tr
            th Benutzer
            th Rolle
            th Status
            th Letzte Anmeldung
            th
        tbody
          - foreach (u; accounts)
            - bool self = u.ID == ctx.user.userId;
            tr
              td
                .bold #{u.displayName}
                .small-text.muted
                  span.mono #{u.userName}
                  - if (u.email.length)
                    |  · #{u.email}
              td
                span(class=u.role == "admin" ? "chip small tag-info" : chip) #{roleLabel(u.role)}
              td
                - if (u.active)
                  span.chip.small.tag-ok aktiv
                - else
                  span.chip.small.tag-bad gesperrt
              td.small-text.nowrap #{dateTime(u.lastLoginAt)}
              td.right-align.nowrap
                button.circle.transparent.small(type="button", data-dialog="#edit-#{u.ID}", title="Bearbeiten")
                  i edit
                button.circle.transparent.small(type="button", data-dialog="#pw-#{u.ID}", title="Passwort setzen")
                  i key
                - if (!self)
                  form(method="post", action="/web/users/#{u.ID}/delete", style="display:inline", hx-confirm="Benutzer „#{u.userName}“ löschen?")
                    input(type="hidden", name="csrf", value=ctx.csrf)
                    button.circle.transparent.small.error-text(type="submit", title="Löschen")
                      i delete

  //- ------------------------------------------------------------ dialogs
  - foreach (u; accounts)
    - bool self = u.ID == ctx.user.userId;
    dialog(id="edit-#{u.ID}")
      h5 #{u.userName} bearbeiten
      form(method="post", action="/web/users/#{u.ID}")
        input(type="hidden", name="csrf", value=ctx.csrf)
        input(type="hidden", name="activeField", value="1")
        .field.label.border
          input(id="ed-name-#{u.ID}", name="displayName", value=u.displayName == u.userName ? "" : u.displayName, placeholder=" ")
          label(for="ed-name-#{u.ID}") Anzeigename
        .field.label.border
          input(id="ed-mail-#{u.ID}", type="email", name="email", value=u.email, placeholder=" ")
          label(for="ed-mail-#{u.ID}") E-Mail
        .field.label.suffix.border
          select(id="ed-role-#{u.ID}", name="role")
            - foreach (r; userRoles)
              option(value=r, selected=(r == u.role)) #{roleLabel(r)}
          label(for="ed-role-#{u.ID}") Rolle
          i arrow_drop_down
        - if (self)
          input(type="hidden", name="active", value="on")
          p.small-text.muted Das eigene Konto kann nicht gesperrt werden.
        - else
          label.switch
            input(type="checkbox", name="active", checked=u.active)
            span
          span  Konto aktiv (gesperrte Benutzer können sich nicht anmelden)
        nav.right-align.top-margin
          button.border(type="button", data-dialog="#edit-#{u.ID}") Abbrechen
          button(type="submit") Speichern
    dialog(id="pw-#{u.ID}")
      h5 Passwort für #{u.userName} setzen
      form(method="post", action="/web/users/#{u.ID}/password")
        input(type="hidden", name="csrf", value=ctx.csrf)
        input(type="hidden", name="username", value=u.userName, autocomplete="username")
        .field.label.border
          input(id="pw1-#{u.ID}", type="password", name="password", autocomplete="new-password", required, minlength="10", placeholder=" ")
          label(for="pw1-#{u.ID}") Neues Passwort (mind. 10 Zeichen)
        .field.label.border
          input(id="pw2-#{u.ID}", type="password", name="password2", autocomplete="new-password", required, minlength="10", placeholder=" ")
          label(for="pw2-#{u.ID}") Wiederholen
        nav.right-align
          button.border(type="button", data-dialog="#pw-#{u.ID}") Abbrechen
          button(type="submit") Passwort setzen

  dialog#new-user
    h5 Neuer Benutzer
    form(method="post", action="/web/users")
      input(type="hidden", name="csrf", value=ctx.csrf)
      .field.label.border
        input#nu-user(name="userName", required, minlength="3", maxlength="64", autocomplete="off", placeholder=" ")
        label(for="nu-user") Benutzername *
      .field.label.border
        input#nu-name(name="displayName", placeholder=" ")
        label(for="nu-name") Anzeigename
      .field.label.border
        input#nu-mail(type="email", name="email", placeholder=" ")
        label(for="nu-mail") E-Mail
      .field.label.suffix.border
        select#nu-role(name="role")
          - foreach (r; userRoles)
            option(value=r, selected=(r == "editor")) #{roleLabel(r)}
        label(for="nu-role") Rolle
        i arrow_drop_down
      .field.label.border
        input#nu-pw(type="password", name="password", autocomplete="new-password", required, minlength="10", placeholder=" ")
        label(for="nu-pw") Initiales Passwort * (mind. 10 Zeichen)
      .field.label.border
        input#nu-pw2(type="password", name="password2", autocomplete="new-password", required, minlength="10", placeholder=" ")
        label(for="nu-pw2") Passwort wiederholen *
      nav.right-align
        button.border(type="button", data-dialog="#new-user") Abbrechen
        button(type="submit") Anlegen
