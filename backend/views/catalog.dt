extends layout

block content
  - import uim.myfiori.presentation.web.helpers;
  h1.text-2xl.font-bold.mb-1 IT-Grundschutz-Kompendium
  p.text-sm.opacity-70.mb-6 #{edition} – maßgeblich ist stets die aktuelle Edition des BSI.

  .grid.gap-6(class="lg:grid-cols-3")
    .flex.flex-col.gap-3(class="lg:col-span-2")
      h2.text-xl.font-semibold Bausteine
      - foreach (m; modules)
        .collapse.collapse-arrow.bg-base-100.shadow
          input(type="checkbox")
          .collapse-title
            span.font-mono.mr-2 #{m.code}
            span.font-medium #{m.title}
            span.badge.badge-ghost.ml-2 #{m.requirementCount}
          .collapse-content
            p.text-sm.opacity-70.mb-2 #{m.description}
            table.table.table-sm
              tbody
                - foreach (r; requirementsByModule[m.code])
                  tr
                    td.font-mono.whitespace-nowrap #{r.code}
                    td #{r.title}
                    td
                      span(class=badge(r.level)) #{de(r.level)}
    .flex.flex-col.gap-3
      h2.text-xl.font-semibold Elementare Gefährdungen
      .card.bg-base-100.shadow
        .card-body.p-2
          table.table.table-xs
            tbody
              - foreach (t; threats)
                tr
                  td.font-mono.whitespace-nowrap #{t.code}
                  td #{t.title}
