extends auth_layout

block content
  h6 Anmelden
  form(method="post", action="/login")
    input(type="hidden", name="next", value=next)
    .field.label.border.prefix
      i person
      input#userName(name="userName", value=userName, autocomplete="username", required, autofocus, placeholder=" ")
      label(for="userName") Benutzername
    .field.label.border.prefix
      i key
      input#password(type="password", name="password", autocomplete="current-password", required, placeholder=" ")
      label(for="password") Passwort
    nav.right-align
      button(type="submit")
        i login
        span Anmelden
