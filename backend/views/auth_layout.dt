doctype html
html(lang="de")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title #{pageTitle} · BSI IT-Grundschutz
    include head
  body
    main.responsive
      article.auth-card.round.padding
        nav.bottom-margin
          button.circle.extra.primary(type="button", tabindex="-1")
            i shield
          div.max
            h5.no-margin BSI IT-Grundschutz
            div.small-text.muted Sicherheitskonzeption nach BSI 200-2 / 200-3
        - if (msg.length)
          article.secondary-container.round.no-elevate(role="status") #{msg}
        - if (err.length)
          article.error-container.round.no-elevate(role="alert")
            nav
              i error
              div.max #{err}
        block content
