doctype html
html(lang="de", data-theme="corporate")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title #{pageTitle} · BSI IT-Grundschutz
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css")
    script(src="https://cdn.tailwindcss.com/3.4.5")
    link(rel="stylesheet", href="/public/app.css")
  body.min-h-screen.bg-base-200
    .navbar.bg-primary.text-primary-content.shadow
      .flex-1
        a.btn.btn-ghost.text-lg(href="/web") 🛡️ IT-Grundschutz
      .flex-none.gap-2
        a.btn.btn-ghost.btn-sm(href="/web") Projekte
        a.btn.btn-ghost.btn-sm(href="/web/catalog") Kompendium
        a.btn.btn-ghost.btn-sm(href="/web/admin") Daten & Sicherung
        a.btn.btn-ghost.btn-sm(href="/ui/index.html") Fiori-App
        span(class="badge badge-outline hidden md:inline-flex") #{userName}
    main.container.mx-auto.p-4.max-w-7xl
      - if (msg.length)
        .alert.alert-success.mb-4(role="status") #{msg}
      - if (err.length)
        .alert.alert-error.mb-4(role="alert") #{err}
      block content
    footer.footer.footer-center.p-4.text-base-content.opacity-60
      p BSI-Standards 200-2 / 200-3 · OData v4: /odata/v4/grundschutz/
