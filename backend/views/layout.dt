doctype html
html(lang="de")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    meta(name="htmx-config", content='{"historyCacheSize":0,"refreshOnHistoryMiss":true,"scrollIntoViewOnBoost":false}')
    title #{ctx.pageTitle} · BSI IT-Grundschutz
    include head
  - import uim.myfiori.presentation.web.helpers : activeIf;
  body(hx-boost="true")
    nav.left.m.l
      header
        a.circle.extra.primary(href="/web", title="IT-Grundschutz")
          i shield
      a(href="/web", class=activeIf(ctx.nav == "projects"))
        i folder_shared
        span Projekte
      a(href="/web/catalog", class=activeIf(ctx.nav == "catalog"))
        i menu_book
        span Kompendium
      a(href="/web/admin", class=activeIf(ctx.nav == "admin"))
        i database
        span Daten
      - if (ctx.loginEnabled && ctx.isAdmin)
        a(href="/web/users", class=activeIf(ctx.nav == "users"))
          i group
          span Benutzer
      a(href="/ui/index.html", hx-boost="false")
        i apps
        span Fiori-App
    nav.bottom.s
      a(href="/web", class=activeIf(ctx.nav == "projects"))
        i folder_shared
      a(href="/web/catalog", class=activeIf(ctx.nav == "catalog"))
        i menu_book
      a(href="/web/admin", class=activeIf(ctx.nav == "admin"))
        i database
      - if (ctx.loginEnabled && ctx.isAdmin)
        a(href="/web/users", class=activeIf(ctx.nav == "users"))
          i group
    header.fixed.primary
      nav
        h6.max
          a(href="/web") BSI IT-Grundschutz
        button.circle.transparent(type="button", onclick="gsToggleTheme()", title="Hell / Dunkel")
          i dark_mode
        - if (ctx.loginEnabled)
          a.button.transparent(href="/web/account", class=activeIf(ctx.nav == "account"), title="Mein Konto")
            i account_circle
            span.m.l #{ctx.displayName}
          form(method="post", action="/logout")
            input(type="hidden", name="csrf", value=ctx.csrf)
            button.circle.transparent(type="submit", title="Abmelden")
              i logout
        - else
          span.chip.small.transparent.m.l
            i person
            span #{ctx.displayName}
    main.responsive
      - if (ctx.msg.length)
        div(hidden, data-gs-message=ctx.msg)
      - if (ctx.err.length)
        article.error-container.round.bottom-margin(role="alert")
          nav
            i error
            div.max #{ctx.err}
      block content
      footer.center-align.small-text.muted.top-margin.bottom-margin
        p BSI-Standards 200-2 / 200-3 · OData v4: /odata/v4/grundschutz/
